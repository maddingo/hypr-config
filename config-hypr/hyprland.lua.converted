-- TAGS - add apps under the appropriate tag to reuse the same settings

-- browser tags
hl.window_rule({
  name = "tag-browser-firefox",
  match = { class = "^([Ff]irefox|org.mozilla.firefox|[Ff]irefox-esr|[Ff]irefox-bin)$" },
  tag = "+browser",
})
