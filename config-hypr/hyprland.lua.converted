-- Workspaces
-- NOTE: SUPER + Tab / SUPER + SHIFT + Tab are also bound to group navigation
-- above. Both binds exist in Keybinds.conf; kept as-is.
hl.bind("SUPER + tab", hl.dsp.focus({ workspace = "m+1" }), { description = "Next workspace" })
hl.bind("SUPER + SHIFT + tab", hl.dsp.focus({ workspace = "m-1" }), { description = "Previous workspace" })

-- Special workspace
hl.bind("SUPER + SHIFT + U", hl.dsp.window.move({ workspace = "special" }), { description = "Move to special workspace" })
hl.bind("SUPER + U", hl.dsp.workspace.toggle_special(), { description = "Toggle special workspace" })

-- Keybinds.conf uses key codes (code:10 = 1 ... code:19 = 0) to stay layout
-- independent. The Lua bind parser takes keysyms, so bind the digit and - for
-- the SHIFT variants - the shifted symbol as well.
local number_keys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" }
local shifted_number_keys = {
  "exclam",
  "at",
  "numbersign",
  "dollar",
  "percent",
  "asciicircum",
  "ampersand",
  "asterisk",
  "parenleft",
  "parenright",
}

for i = 1, 10 do
  local key = number_keys[i]
  local shifted = shifted_number_keys[i]

  hl.bind("SUPER + " .. key, hl.dsp.focus({ workspace = i }), { description = "Workspace " .. i })

  hl.bind("SUPER + SHIFT + " .. key, hl.dsp.window.move({ workspace = i }), { description = "Move to workspace " .. i })
  hl.bind("SUPER + SHIFT + " .. shifted, hl.dsp.window.move({ workspace = i }), { description = "Move to workspace " .. i })

  hl.bind(
    "SUPER + CTRL + " .. key,
    hl.dsp.window.move({ workspace = i, follow = false }),
    { description = "Move silently to workspace " .. i }
  )
end

hl.bind(
  "SUPER + SHIFT + bracketleft",
  hl.dsp.window.move({ workspace = "-1" }),
  { description = "Move to previous workspace" }
)
hl.bind(
  "SUPER + SHIFT + bracketright",
  hl.dsp.window.move({ workspace = "+1" }),
  { description = "Move to next workspace" }
)
hl.bind(
  "SUPER + CTRL + bracketleft",
  hl.dsp.window.move({ workspace = "-1", follow = false }),
  { description = "Move silently to previous workspace" }
)
hl.bind(
  "SUPER + CTRL + bracketright",
  hl.dsp.window.move({ workspace = "+1", follow = false }),
  { description = "Move silently to next workspace" }
)

-- Scroll through existing workspaces
hl.bind("SUPER + mouse_down", hl.dsp.focus({ workspace = "e+1" }), { description = "Next workspace" })
hl.bind("SUPER + mouse_up", hl.dsp.focus({ workspace = "e-1" }), { description = "Previous workspace" })
hl.bind("SUPER + period", hl.dsp.focus({ workspace = "e+1" }), { description = "Next workspace" })
hl.bind("SUPER + comma", hl.dsp.focus({ workspace = "e-1" }), { description = "Previous workspace" })

-- Move/resize windows with SUPER + LMB/RMB and dragging
hl.bind("SUPER + mouse:272", hl.dsp.window.drag(), { mouse = true, description = "Move window" })
hl.bind("SUPER + mouse:273", hl.dsp.window.resize(), { mouse = true, description = "Resize window" })

-- ==================================================
-- configs/Laptops.conf
-- (UserConfigs/Laptops.conf and UserConfigs/LaptopDisplay.conf have no
--  active entries - the lid-switch handling there is all commented out)
-- ==================================================

hl.bind(
  "XF86KbdBrightnessDown",
  exec(scriptsDir .. "/BrightnessKbd.sh --dec"),
  { repeating = true, description = "Decrease keyboard brightness" }
)
hl.bind(
  "XF86KbdBrightnessUp",
  exec(scriptsDir .. "/BrightnessKbd.sh --inc"),
  { repeating = true, description = "Increase keyboard brightness" }
)
hl.bind("XF86Launch1", exec("rog-control-center"), { description = "ASUS Armory crate button" })
hl.bind("XF86Launch3", exec("asusctl led-mode -n"), { description = "Switch keyboard RGB profile" })
hl.bind("XF86Launch4", exec("asusctl profile -n"), { description = "Change fan profile" })
hl.bind(
  "XF86MonBrightnessDown",
  exec(scriptsDir .. "/Brightness.sh --dec"),
  { repeating = true, description = "Decrease monitor brightness" }
)
hl.bind(
  "XF86MonBrightnessUp",
  exec(scriptsDir .. "/Brightness.sh --inc"),
  { repeating = true, description = "Increase monitor brightness" }
)
hl.bind("XF86TouchpadToggle", exec(scriptsDir .. "/TouchPad.sh"), { description = "Disable touchpad" })

-- Screenshot keybindings using F6 (for keyboards without a PrintScreen key)
hl.bind("SUPER + F6", exec(scriptsDir .. "/ScreenShot.sh --now"), { description = "Screenshot" })
hl.bind("SUPER + SHIFT + F6", exec(scriptsDir .. "/ScreenShot.sh --area"), { description = "Screenshot (area)" })
hl.bind("SUPER + CTRL + F6", exec(scriptsDir .. "/ScreenShot.sh --in5"), { description = "Screenshot (5 secs delay)" })
hl.bind("SUPER + ALT + F6", exec(scriptsDir .. "/ScreenShot.sh --in10"), { description = "Screenshot (10 secs delay)" })
hl.bind("ALT + F6", exec(scriptsDir .. "/ScreenShot.sh --active"), { description = "Screenshot (active window only)" })

hl.device({
  name = "asue1209:00-04f3:319f-touchpad",
  enabled = true,
})

