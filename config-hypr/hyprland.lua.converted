-- ==================================================
--  Converted from ~/.config/hypr/hyprland.conf
--  (KoolDots 2026 / https://github.com/LinuxBeginnings)
--
--  Source files, in the order hyprland.conf sources them:
--    configs/Keybinds.conf          (which itself sources UserConfigs/01-UserDefaults.conf)
--    configs/Startup_Apps.conf      + UserConfigs/Startup_Apps.conf      (empty)
--    configs/ENVariables.conf       + UserConfigs/ENVariables.conf       (all commented out)
--    configs/Laptops.conf           + UserConfigs/Laptops.conf           (all commented out)
--    UserConfigs/LaptopDisplay.conf (all commented out)
--    configs/WindowRules.conf       + UserConfigs/WindowRules.conf       (empty)
--    configs/LayerRules.conf        + UserConfigs/LayerRules.conf        (empty)
--    configs/SystemSettings.conf
--    UserConfigs/UserDecorations.conf (which sources wallust/wallust-hyprland.conf)
--    UserConfigs/UserAnimations.conf
--    UserConfigs/UserKeybinds.conf  (all commented out)
--    UserConfigs/UserSettings.conf  (empty)
--    UserConfigs/01-UserDefaults.conf
--    monitors.conf
--    workspaces.conf
--
--  Only entries that are actually active in those files are converted.
--  Commented-out examples from the sources are dropped; a few constructs
--  without a Lua equivalent are noted inline as TODO.
-- ==================================================

local home = os.getenv("HOME") or ""
local configHome = os.getenv("XDG_CONFIG_HOME") or (home .. "/.config")
local hyprDir = configHome .. "/hypr"

local scriptsDir = hyprDir .. "/scripts"
local userScripts = hyprDir .. "/UserScripts"

local function exec(cmd)
  return hl.dsp.exec_cmd(cmd)
end

-- Escape hatch for dispatchers that have no typed hl.dsp.* equivalent yet.
local function raw(cmd)
  return hl.dsp.exec_raw(cmd)
end

-- ==================================================
-- UserConfigs/01-UserDefaults.conf
-- ==================================================

hl.env("EDITOR", "nvim")
hl.env("VISUAL", "nvim-qt")

local term = "kitty"
local files = "thunar"

-- NOTE: $edit (${EDITOR:-nano}), $visual (${VISUAL:-nvim-qt}) and
-- $Search_Engine ("https://www.google.com/search?q={}") are hyprlang variables
-- that the KooL shell scripts read back out of the .conf files. They have no
-- Lua equivalent; the scripts fall back to their own defaults.

-- ==================================================
-- Startup
--   hyprland.conf            -> initial-boot.sh
--   configs/Keybinds.conf    -> ChangeLayout.sh init
--   configs/Startup_Apps.conf
--   UserConfigs/Startup_Apps.conf is empty
-- ==================================================

hl.on("hyprland.start", function()
  -- Initial boot script: applies initial wallpapers, theming, new settings etc.
  -- Guarded by ~/.config/hypr/.initial_startup_done, so it self-disables.
  hl.exec_cmd(hyprDir .. "/initial-boot.sh")

  -- Legacy init hook from Keybinds.conf; keybind behaviour is resolved dynamically.
  hl.exec_cmd(scriptsDir .. "/ChangeLayout.sh init")

  -- Wallpaper
  hl.exec_cmd("sh -c 'sleep 2; " .. scriptsDir .. "/WallpaperDaemon.sh'")

  -- Session plumbing
  hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
  hl.exec_cmd("systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
  hl.exec_cmd(scriptsDir .. "/Polkit.sh")
  hl.exec_cmd("nm-applet")
  hl.exec_cmd("swaync")
  hl.exec_cmd(scriptsDir .. "/PortalHyprland.sh")
  hl.exec_cmd("sh " .. scriptsDir .. "/ApplyThemeMode.sh")
  hl.exec_cmd("sh " .. scriptsDir .. "/WaybarStartup.sh")

  -- Cursor refresh (enabled by installer on hybrid NVIDIA/GDM setups)
  hl.exec_cmd("sh -c 'sleep 0.3; hyprctl setcursor \"${HYPRCURSOR_THEME:-Bibata-Modern-Ice}\" \"${HYPRCURSOR_SIZE:-24}\"'")

  hl.exec_cmd("qs -c overview") -- Quickshell Overview
  hl.exec_cmd("hypridle")
  hl.exec_cmd(scriptsDir .. "/LuaAutoReload.sh")
  hl.exec_cmd(scriptsDir .. "/Hyprsunset.sh init")

  -- NOTE: Dropterminal is currently certified only with kitty.
  hl.exec_cmd(scriptsDir .. "/Dropterminal.sh --startup kitty")

  -- Clipboard manager
  hl.exec_cmd("wl-paste --type text --watch cliphist store")
  hl.exec_cmd("wl-paste --type image --watch cliphist store")

  hl.exec_cmd("blueman-applet")
  hl.exec_cmd(scriptsDir .. "/KeybindsLayoutInit.sh")
  hl.exec_cmd("ags")
  hl.exec_cmd("qs")
end)

