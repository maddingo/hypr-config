  name = "opacity-browser-tag",
  match = { tag = "browser" },
  opacity = "0.99 0.8",
})
hl.window_rule({
  name = "opacity-projects-tag",
  match = { tag = "projects" },
  opacity = "0.9 0.8",
})
hl.window_rule({
  name = "opacity-im-tag",
  match = { tag = "im" },
  opacity = "0.94 0.86",
})
hl.window_rule({
  name = "opacity-multimedia-tag",
  match = { tag = "multimedia" },
  opacity = "0.94 0.86",
})
hl.window_rule({
  name = "opacity-file-manager-tag",
  match = { tag = "file-manager" },
  opacity = "0.9 0.8",
})
hl.window_rule({
  name = "opacity-terminal-tag",
  match = { tag = "terminal" },
  opacity = "0.9 0.7",
})
hl.window_rule({
  name = "opacity-text-editors",
  match = { class = "^(gedit|org.gnome.TextEditor|mousepad)$" },
