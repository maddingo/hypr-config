})
hl.window_rule({
  name = "opacity-seahorse",
  match = { class = "^(seahorse)$" },
  opacity = "0.9 0.8",
})

-- BLUR & FULLSCREEN
-- Do not steal focus with the hover popups of the IntelliJ products.
hl.window_rule({
  name = "no-initial-focus-jetbrains",
  match = { class = "^(jetbrains-.*)$" },
  no_initial_focus = true,
})
