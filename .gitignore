.envrc

# Hyprland writes this stub ("autogenerated = 1") whenever it needs a config at
# ~/.config/hypr/hyprland.conf and finds none — which happens if the config
# directory is swapped under a live session. It arrives here through the symlink.
# This repo's Hyprland config is hyprland.lua; delete this line if that changes.
config-hypr/hyprland.conf
